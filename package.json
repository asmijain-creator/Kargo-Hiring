{
  "name": "kargo-screening",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && node prisma/seed.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "setup": "prisma db push && node prisma/seed.mjs",
    "postinstall": "prisma generate",
    "build:local": "prisma generate && next build"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/client": "^6.19.3",
    "mammoth": "^1.13.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
