# =====================================================================
#  Kargo Hiring - settings
#  Fill in the lines marked  <-- FILL IN, save, then restart the app
#  (stop "npm run dev" and start it again).
#  Never share this file or commit it to git: it holds your secret keys.
# =====================================================================


# ---------------------------------------------------------------------
# 1. GEMINI (scores CVs, writes briefs, drafts invite emails)
#    Get a key: https://aistudio.google.com/apikey -> Create API key
#    It usually starts with "AIza". The free tier works but has low rate limits.
# ---------------------------------------------------------------------
GEMINI_API_KEY=""                                   # <-- FILL IN


# ---------------------------------------------------------------------
# 2. RESEND (sends the invite and rejection emails when you click Confirm & send)
#    Get a key: https://resend.com -> API Keys -> Create API Key
#    (permission "Sending access" is enough). It starts with "re_".
# ---------------------------------------------------------------------
RESEND_API_KEY=""                                      # <-- FILL IN

# Who the email comes from.
# - Testing without your own domain: keep the default below. Resend only lets
#   onboarding@resend.dev send to the email address you signed up to Resend with.
# - Real use: verify a domain in Resend (Domains -> Add Domain), then change this
#   to an address on it, e.g. "Kargo Hiring <hiring@yourdomain.com>".
EMAIL_FROM="Kargo Hiring <onboarding@resend.dev>"

# TEST MODE - strongly recommended while testing.
# Every email goes to this address instead of the candidate.
# Put the email address you signed up to Resend with.
# Clear it (EMAIL_TEST_REDIRECT="") only when you want real candidates to receive emails.
EMAIL_TEST_REDIRECT=""                                 # <-- FILL IN (your Resend sign-up email)

# Optional: where candidate replies go (e.g. your own inbox). Leave empty to skip.
EMAIL_REPLY_TO=""


# ---------------------------------------------------------------------
# 3. BEHAVIOUR (fine as they are)
# ---------------------------------------------------------------------
# Name recorded on each Advance/Decline decision.
SCREENER_NAME="Arjun Mehta"

# "true": the email sends the moment you click Advance or Decline.
# "false": emails wait in the Outbox until you press Send.
EMAIL_AUTO_SEND="true"

# Optional: a different Gemini model. Leave empty for the default (gemini-3.8-flash).
GEMINI_MODEL=""



# ---------------------------------------------------------------------
# 4. DATABASE (Supabase Postgres). Supabase -> Connect -> ORMs -> Prisma shows both.
#    Locally, copy them from Vercel -> Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------
DATABASE_URL=""
DIRECT_URL=""

# ---------------------------------------------------------------------
# 5. LOGIN - the shared password for the app. Required on Vercel.
#    Leave empty locally to skip the login screen.
# ---------------------------------------------------------------------
APP_PASSWORD=""
